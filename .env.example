# ===== Root .env.example — copy to .env and fill in real values =====
# Used by docker-compose.yml for local dev

POSTGRES_DB=civicbridge
POSTGRES_USER=civicbridge
POSTGRES_PASSWORD=change_me_locally

REDIS_PORT=6379

# Backend
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://postgres:5432/civicbridge
DB_USERNAME=civicbridge
DB_PASSWORD=change_me_locally
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=replace_with_a_long_random_base64_secret_min_32_bytes
JWT_EXPIRATION_MS=3600000
FILE_STORAGE_PATH=/data/uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI guidance (Phase 3 — optional until implemented)
AI_PROVIDER_API_KEY=
