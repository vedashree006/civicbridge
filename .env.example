# ===== Root .env.example — copy to .env and fill in real values =====
# Used by docker-compose.yml for local dev

POSTGRES_DB=civicbridge
POSTGRES_USER=civicbridge
POSTGRES_PASSWORD=change_me_locally

REDIS_PORT=6379

# Backend
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://postgres:5432/civicbridge
DB_USERNAME=civicbridge
DB_PASSWORD=change_me_locally
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=replace_with_a_long_random_base64_secret_min_32_bytes
JWT_EXPIRATION_MS=3600000
FILE_STORAGE_PATH=/data/uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI guidance (Phase 3 — optional until implemented)
AI_PROVIDER_API_KEY=

# ===== Session tracking, analytics & consent (all optional; defaults shown) =====
# Active = session seen within this many seconds (default five minutes)
ANALYTICS_ACTIVE_WINDOW_SECONDS=300
ANALYTICS_TOUCH_INTERVAL_SECONDS=30
ANALYTICS_SESSION_CACHE_SECONDS=60
ANALYTICS_EVENT_RETENTION_DAYS=90
ANALYTICS_SESSION_RETENTION_DAYS=30
CONSENT_RETENTION_DAYS=1095
ANALYTICS_ZONE=Europe/Berlin
# REQUIRED in production: long random secret used to salt daily visitor hashes (generate with: openssl rand -base64 32)
ANALYTICS_HASH_SALT=replace_with_random_secret
# Set true only temporarily to accept JWTs issued before the upgrade (they carry no session id)
ANALYTICS_ALLOW_LEGACY_TOKENS=false
ANALYTICS_COLLECT_PER_MINUTE=60
# Bump to re-prompt all visitors for cookie consent (keep equal to CONSENT_VERSION in frontend/src/consent/consentStore.ts)
CONSENT_POLICY_VERSION=2026-10-1
# Hibernate schema mode. Use 'validate' in production once migrations are applied.
JPA_DDL_AUTO=update
